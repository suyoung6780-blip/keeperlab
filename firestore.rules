rules_version = '2';
// KEEPER LAB 트레이닝 피드백
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'admin@keeperlab.co.kr';
    }
    function isPlayer(pid) {
      return request.auth != null
        && get(/databases/$(db)/documents/players/$(pid)).data.uid == request.auth.uid;
    }

    match /players/{pid} {
      // 누구나: 가려진 이름(유*영)만 들어 있는 목록
      allow read: if true;
      allow write: if isAdmin();

      // 이름 · 소속 · 비밀번호: 관리자와 그 선수 본인만
      match /private/{doc} {
        allow read: if isAdmin() || isPlayer(pid);
        allow write: if isAdmin();
      }

      // 피드백: 관리자와 그 선수 본인만. 선수는 '확인' 체크만 바꿀 수 있어요
      match /feedback/{fid} {
        allow read: if isAdmin() || isPlayer(pid);
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          || (isPlayer(pid)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checked', 'checkedAt'])
              && request.resource.data.checked == true);
      }
    }

    // 아카이브: 누구나 올릴 수 있지만 '승인 대기'로 들어가고, 관리자가 승인해야 공개돼요
    match /archive/{id} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if isAdmin() || validPending(request.resource.data);
      allow update, delete: if isAdmin();
    }
    function validPending(d) {
      return d.status == 'pending'
        && d.keys().hasOnly(['type', 'author', 'org', 'topic', 'title', 'channel', 'url', 'desc', 'lead',
                             'srcTitle', 'srcInfo', 'intro', 'sections', 'thought', 'img', 'status', 'createdAt'])
        && d.type in ['video', 'paper', 'analysis']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.author is string && d.author.size() > 0 && d.author.size() <= 20
        && d.createdAt == request.time
        && (!('img' in d) || (d.img is string && d.img.size() < 750000 && d.img.matches('^data:image/jpeg;base64,.*')))
        && (!('sections' in d) || (d.sections is list && d.sections.size() <= 30));
    }

    // GK 코치 대화방: 아이디로 가입 신청 → 관리자가 승인한 코치만 보고 써요
    function coachDoc() {
      return get(/databases/$(db)/documents/coaches/$(request.auth.uid)).data;
    }
    function isCoach() {
      return request.auth != null
        && exists(/databases/$(db)/documents/coaches/$(request.auth.uid))
        && coachDoc().status == 'approved';
    }
    function canTalk() { return isAdmin() || isCoach(); }
    function validPost(d) {
      return d.cat in ['GK코치 공고', 'GK코치 자리 찾기', 'GK선수 모집 및 팀 모집', 'GK코치들의 이야기']
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.body is string && d.body.size() > 0 && d.body.size() <= 5000
        && d.author is string && d.author.size() > 0 && d.author.size() <= 20
        && (!('org' in d) || (d.org is string && d.org.size() <= 30))
        && (!('contact' in d) || (d.contact is string && d.contact.size() <= 80))
        && (!('region' in d) || (d.region is string && d.region.size() <= 20));
    }

    // 코치 가입 정보: 본인과 관리자만 봐요. 처음엔 '승인 대기'로만 만들 수 있고, 승인은 관리자만
    match /coaches/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'name', 'org', 'status', 'createdAt'])
        && request.resource.data.status == 'pending'
        && request.resource.data.id is string && request.resource.data.id.matches('^[a-z0-9_]{4,20}$')
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.org is string && request.resource.data.org.size() > 0 && request.resource.data.org.size() <= 30
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'approved', 'rejected'];
      allow delete: if isAdmin();
    }

    match /talk/{pid} {
      allow read: if canTalk();
      allow create: if validPost(request.resource.data) && request.resource.data.createdAt == request.time
        && ((isAdmin()
              && request.resource.data.keys().hasOnly(['cat', 'title', 'body', 'author', 'org', 'contact', 'region', 'byAdmin', 'createdAt']))
          || (isCoach()
              && request.resource.data.keys().hasOnly(['cat', 'title', 'body', 'author', 'org', 'contact', 'region', 'uid', 'createdAt'])
              && request.resource.data.uid == request.auth.uid
              && request.resource.data.author == coachDoc().name
              && request.resource.data.org == coachDoc().org));
      allow update: if isAdmin()
        || (isCoach() && resource.data.uid == request.auth.uid && validPost(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cat', 'title', 'body', 'contact', 'region', 'updatedAt']));
      allow delete: if isAdmin() || (isCoach() && resource.data.uid == request.auth.uid);

      match /comments/{cid} {
        allow read: if canTalk();
        allow create: if request.resource.data.body is string
          && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 1000
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(db)/documents/talk/$(pid))
          && ((isAdmin() && request.resource.data.keys().hasOnly(['author', 'org', 'body', 'byAdmin', 'createdAt']))
            || (isCoach()
                && request.resource.data.keys().hasOnly(['author', 'org', 'body', 'uid', 'createdAt'])
                && request.resource.data.uid == request.auth.uid
                && request.resource.data.author == coachDoc().name
                && request.resource.data.org == coachDoc().org));
        allow delete: if isAdmin() || (isCoach() && resource.data.uid == request.auth.uid);
      }
    }

    // 대화방 공지: 승인된 코치가 보고, 관리자만 올리고 고치고 내려요
    match /talkNotice/{id} {
      allow read: if canTalk();
      allow create, update: if isAdmin()
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.where is list && request.resource.data.where.size() > 0;
      allow delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
